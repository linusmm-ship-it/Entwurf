<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="habittracker.mockup.HauptmenueView">
  <grid id="27dc6" binding="panel" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="ea3a7" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Hauptmenü"/>
        </properties>
      </component>
      <component id="9d97f" class="javax.swing.JLabel" binding="tageswertLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Heute erfasst - 20 Min."/>
        </properties>
      </component>
      <component id="89124" class="javax.swing.JComboBox" binding="bereichBox">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Calibri" size="11"/>
          <model>
            <item value="Auswählen"/>
            <item value="Sport und Hobbys"/>
            <item value="Medikamente und Nahrungsergänzungsmittel"/>
            <item value="Social-Media-Zeiten"/>
            <item value="DB-Wartezeit"/>
          </model>
        </properties>
      </component>
      <component id="d7180" class="javax.swing.JButton" binding="oeffnenButton">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="öffnen"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
